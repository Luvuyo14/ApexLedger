<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gray_50">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:titleTextColor="@color/navy"
        app:navigationIcon="@drawable/ic_back_arrow"
        app:title="Admin Panel" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_banner_gradient"
        android:padding="18dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin Control Panel"
                android:textColor="@color/on_primary"
                android:textStyle="bold"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System administration and user management"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSystemOnline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● System Online"
            android:textColor="@color/on_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_pill_translucent"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:tabTextColor="@color/gray_500"
        app:tabSelectedTextColor="@color/primary"
        app:tabIndicatorColor="@color/primary"
        app:tabMode="scrollable">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Management" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permissions" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audit Log" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System Health" />

    </com.google.android.material.tabs.TabLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- SECTION 1: User Management -->
            <LinearLayout
                android:id="@+id/sectionUserManagement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="visible">

                <LinearLayout
                    android:id="@+id/cardAddStaff"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_stroke"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Staff Accounts"
                        android:textColor="@color/navy"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginBottom="12dp" />

                    <TextView android:text="Full Name" android:textColor="@color/navy_700" android:textStyle="bold" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <EditText
                        android:id="@+id/etStaffName"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp" />
                    <TextView
                        android:id="@+id/tvErrorStaffName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/danger_dark"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone" />

                    <TextView android:text="Email" android:textColor="@color/navy_700" android:textStyle="bold" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <EditText
                        android:id="@+id/etStaffEmail"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:inputType="textEmailAddress"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp" />
                    <TextView
                        android:id="@+id/tvErrorStaffEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/danger_dark"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone" />

                    <TextView android:text="Temporary Password" android:textColor="@color/navy_700" android:textStyle="bold" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <EditText
                        android:id="@+id/etStaffPassword"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:inputType="textPassword"
                        android:hint="Min 8 chars"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp" />
                    <TextView
                        android:id="@+id/tvErrorStaffPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/danger_dark"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone" />

                    <TextView android:text="Role" android:textColor="@color/navy_700" android:textStyle="bold" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <Spinner
                        android:id="@+id/spinnerRole"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_input_field"
                        android:layout_marginTop="4dp" android:layout_marginBottom="12dp" />

                    <TextView android:text="Duty / Department" android:textColor="@color/navy_700" android:textStyle="bold" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <Spinner
                        android:id="@+id/spinnerDepartment"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_input_field"
                        android:layout_marginTop="4dp" android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Every accountant owns one duty. Client queries about that duty are routed to them directly — clients never need admin sign-off to reach the right person."
                        android:textColor="@color/gray_400"
                        android:textSize="10sp"
                        android:layout_marginBottom="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCreateStaff"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Create User"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:backgroundTint="@color/success" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/danger_dark"
                        android:textSize="13sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_stroke"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tvStaffTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="All Staff"
                            android:textColor="@color/navy"
                            android:textStyle="bold"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/btnToggleAddStaff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+ Add Staff"
                            android:textColor="@color/on_primary"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:background="@drawable/bg_button_primary_small"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStaffEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No staff accounts yet"
                        android:textColor="@color/gray_500"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:padding="20dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/containerStaff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_stroke"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Assign Client to Accountant"
                        android:textColor="@color/navy"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginBottom="12dp" />

                    <TextView android:text="Client" android:textColor="@color/navy_700" android:textStyle="bold" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <Spinner
                        android:id="@+id/spinnerAssignClient"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_input_field"
                        android:layout_marginTop="4dp" android:layout_marginBottom="12dp" />

                    <TextView android:text="Assign to Accountant" android:textColor="@color/navy_700" android:textStyle="bold" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <Spinner
                        android:id="@+id/spinnerAssignAccountant"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_input_field"
                        android:layout_marginTop="4dp" android:layout_marginBottom="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAssignClient"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Assign"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:backgroundTint="@color/primary"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Clients"
                        android:textColor="@color/navy"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvClientsEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No clients registered yet"
                        android:textColor="@color/gray_500"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:padding="20dp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvClients"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

            </LinearLayout>

            <!-- SECTION 2: Permissions Matrix -->
            <LinearLayout
                android:id="@+id/sectionPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_stroke"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Permissions Matrix"
                        android:textColor="@color/navy"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Role-based access control as defined in the Authentication &amp; Security subsystem (UC-18). Client queries route straight to the responsible accountant by duty — Admin is not a required step in that path."
                        android:textColor="@color/gray_500"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvPermissions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

            </LinearLayout>

            <!-- SECTION 3: Audit Log -->
            <LinearLayout
                android:id="@+id/sectionAuditLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_stroke"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Audit Log"
                            android:textColor="@color/navy"
                            android:textStyle="bold"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last 100 events · NFR-Security compliance"
                            android:textColor="@color/gray_400"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etAuditSearch"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:hint="Search action, details or user type"
                        android:inputType="text"
                        android:textSize="13sp"
                        android:layout_marginBottom="10dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chipAuditAll"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="All"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="7dp"
                                android:layout_marginEnd="8dp" />
                            <TextView
                                android:id="@+id/chipAuditLogins"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Logins"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="7dp"
                                android:layout_marginEnd="8dp" />
                            <TextView
                                android:id="@+id/chipAuditFailed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Failed Logins"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="7dp"
                                android:layout_marginEnd="8dp" />
                            <TextView
                                android:id="@+id/chipAuditTickets"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tickets"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="7dp"
                                android:layout_marginEnd="8dp" />
                            <TextView
                                android:id="@+id/chipAuditAdmin"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Admin actions"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="7dp"
                                android:layout_marginEnd="8dp" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/tvAuditEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No audit events recorded yet"
                        android:textColor="@color/gray_500"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:padding="24dp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAuditLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

            </LinearLayout>

            <!-- SECTION 4: System Health -->
            <LinearLayout
                android:id="@+id/sectionSystemHealth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginHorizontal="6dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvLastChecked"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Last checked: --"
                        android:textColor="@color/gray_500"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnRefreshHealth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Refresh"
                        android:textColor="@color/on_primary"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:background="@drawable/bg_button_primary_small"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include layout="@layout/item_stat_card" android:id="@+id/statStorageUsed" />
                    <include layout="@layout/item_stat_card" android:id="@+id/statActiveClientsHealth" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include layout="@layout/item_stat_card" android:id="@+id/statActiveStaff" />
                    <include layout="@layout/item_stat_card" android:id="@+id/statDocsPending" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include layout="@layout/item_stat_card" android:id="@+id/statFailedLogins" />
                    <include layout="@layout/item_stat_card" android:id="@+id/statAuditEvents" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_stroke"
                    android:padding="16dp"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Service Status"
                        android:textColor="@color/navy"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginBottom="10dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvServiceStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>
    </ScrollView>

</LinearLayout>