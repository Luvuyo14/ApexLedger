<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gray_50">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:titleTextColor="@color/navy"
        app:navigationIcon="@drawable/ic_back_arrow"
        app:title="Client Documents" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_banner_gradient"
        android:paddingHorizontal="18dp"
        android:paddingVertical="14dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Document Management"
            android:textColor="@color/on_primary"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload, review and track client financial documents"
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_margin="6dp">

                <TextView
                    android:id="@+id/tvDocsTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="All Documents"
                    android:textColor="@color/navy"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btnToggleUpload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Upload"
                    android:textColor="@color/on_primary"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:background="@drawable/bg_button_primary_small"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardStaffUpload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_soft"
                android:elevation="2dp"
                android:padding="16dp"
                android:layout_margin="6dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload Document"
                    android:textColor="@color/navy"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Client"
                    android:textColor="@color/gray_500"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />
                <Spinner
                    android:id="@+id/spinnerUploadClient"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_spinner"
                    android:layout_marginBottom="12dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textColor="@color/gray_500"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />
                <Spinner
                    android:id="@+id/spinnerUploadCategory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_spinner"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/staffDropzone"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_input_field"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvStaffDropTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to choose a file"
                        android:textColor="@color/gray_600"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvStaffDropHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PDF, JPG, PNG • max 10MB"
                        android:textColor="@color/gray_500"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStaffUpload"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Upload Securely"
                    android:textColor="@color/on_primary"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:backgroundTint="@color/primary" />
            </LinearLayout>

            <Spinner
                android:id="@+id/spinnerFilterStatus"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_spinner"
                android:layout_margin="6dp" />

            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="32dp"
                android:text="No documents to review right now. Pull down to refresh."
                android:textColor="@color/gray_500"
                android:textSize="13sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStaffDocuments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
