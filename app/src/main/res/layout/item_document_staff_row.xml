<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_stroke"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvFileType"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="PDF"
            android:textColor="@color/on_primary"
            android:textStyle="bold"
            android:textSize="11sp"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDocName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Document.pdf"
                android:textColor="@color/navy"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvClientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Client Name"
                android:textColor="@color/gray_600"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDocStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/navy"
            android:background="@drawable/badge_status_pending"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvDocMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category • Date"
        android:textColor="@color/gray_500"
        android:textSize="11sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvDocAccountant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:textSize="11sp"
        android:background="@drawable/bg_pill_blue"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:layout_marginTop="6dp" />


    <LinearLayout
        android:id="@+id/reviewActionsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApprove"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="Approve"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="@color/success"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReject"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="Reject"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="@color/danger"
            android:layout_marginStart="6dp" />

    </LinearLayout>

</LinearLayout>