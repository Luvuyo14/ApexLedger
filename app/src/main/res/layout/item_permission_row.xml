<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/tvPermissionName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Permission name"
        android:textColor="@color/navy"
        android:textStyle="bold"
        android:textSize="13sp"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/tvAdminMark"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/on_primary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:background="@drawable/bg_mark_yes" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin"
                android:textColor="@color/gray_500"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/tvManagerMark"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/on_primary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:background="@drawable/bg_mark_yes" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manager"
                android:textColor="@color/gray_500"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/tvAccountantMark"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/on_primary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:background="@drawable/bg_mark_yes" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Acct."
                android:textColor="@color/gray_500"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/tvClientMark"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/on_primary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:background="@drawable/bg_mark_yes" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Client"
                android:textColor="@color/gray_500"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_200"
        android:layout_marginTop="12dp" />

</LinearLayout>