<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_soft"
    android:elevation="1dp"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/tvThreadAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="--"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:textSize="14sp"
        android:background="@drawable/bg_avatar_light" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvClientName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="with Client Name"
                android:textColor="@color/navy"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvUrgentPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Urgent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/danger_dark"
                android:background="@drawable/badge_status_overdue"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvUnreadBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/on_primary"
                android:background="@drawable/bg_button_primary_small"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvThreadSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subject"
            android:textColor="@color/gray_600"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvThreadPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last message preview..."
            android:textColor="@color/gray_500"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
