<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTicketNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TAX-2026-0001"
            android:textColor="@color/navy"
            android:textStyle="bold"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/navy"
            android:background="@drawable/badge_status_open"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvTicketService"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Service"
        android:textColor="@color/gray_600"
        android:textSize="13sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvCreated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/gray_500"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tvTicketMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Client Name"
        android:textColor="@color/gray_500"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tvPriorityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medium"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/navy"
            android:background="@drawable/badge_status_pending"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp" />

        <TextView
            android:id="@+id/tvDueText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15 Jun 2026"
            android:textColor="@color/gray_500"
            android:textSize="12sp"
            android:layout_marginStart="10dp" />

        <TextView
            android:id="@+id/tvOverdueChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Overdue"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/danger_dark"
            android:background="@drawable/badge_status_overdue"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginStart="8dp"
            android:visibility="gone" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_200"
        android:layout_marginTop="12dp" />

</LinearLayout>
