rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null &&
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['accountant', 'admin', 'manager'];
    }

    function isAdmin() {
      return request.auth != null &&
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Admins and accountants may upload documents for clients (managers may only review)
    function canUploadForClient() {
      return request.auth != null &&
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['accountant', 'admin'];
    }

    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isStaff() ||
        resource.data.role == 'accountant'
      );

      allow create: if request.auth != null && (
        (request.auth.uid == userId && request.resource.data.role == 'client') ||
        isAdmin()
      );

      allow update: if request.auth != null && (
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.get('department', null) == resource.data.get('department', null) &&
          request.resource.data.get('assignedAccountantId', null) == resource.data.get('assignedAccountantId', null) &&
          request.resource.data.get('taxNumber', null) == resource.data.get('taxNumber', null) &&
          request.resource.data.get('active', null) == resource.data.get('active', null)
        ) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    match /documents/{docId} {
      allow read: if request.auth != null && (resource.data.clientId == request.auth.uid || isStaff());

      // A client can only create a PENDING, incomplete document (no self-approval)
      allow create: if request.auth != null && (
        (
          request.resource.data.clientId == request.auth.uid &&
          request.resource.data.reviewStatus == 'pending' &&
          request.resource.data.uploadComplete == false
        ) ||
        canUploadForClient()
      );

      allow update: if request.auth != null && (
        isStaff() ||
        (resource.data.clientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uploadComplete']))
      );
      allow delete: if request.auth != null && (resource.data.clientId == request.auth.uid || isStaff());

      match /chunks/{chunkId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/documents/$(docId)).data.clientId == request.auth.uid || isStaff()
        );
        allow create: if request.auth != null && (
          get(/databases/$(database)/documents/documents/$(docId)).data.clientId == request.auth.uid ||
          canUploadForClient()
        );
        allow delete: if request.auth != null && (
          get(/databases/$(database)/documents/documents/$(docId)).data.clientId == request.auth.uid || isStaff()
        );
      }
    }

    match /tickets/{ticketId} {
      allow read: if request.auth != null &&
      (resource.data.clientId == request.auth.uid || isStaff());

      // A new ticket must start as 'open'
      allow create: if request.auth != null &&
      request.resource.data.clientId == request.auth.uid &&
      request.resource.data.status == 'open';

      allow update: if request.auth != null && (
        isStaff() ||
        (resource.data.clientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description']))
      );
      allow delete: if isStaff();
    }

    match /ticket_notes/{ticketId} {
      allow read, write: if isStaff();
    }

    match /counters/{doc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.last == 1;
      allow update: if request.auth != null &&
      request.resource.data.last == resource.data.last + 1;
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.recipientUid == request.auth.uid;

      // The sender must be the signed-in user, and only known fields are allowed
      allow create: if request.auth != null &&
      request.resource.data.senderUid == request.auth.uid &&
      request.resource.data.recipientUid is string &&
      request.resource.data.isRead == false &&
      request.resource.data.keys().hasOnly(
        ['recipientUid', 'senderUid', 'type', 'title', 'body', 'targetId', 'isRead', 'createdAt']);

      // The recipient can only mark it as read
      allow update: if request.auth != null &&
      resource.data.recipientUid == request.auth.uid &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);

      allow delete: if request.auth != null && resource.data.recipientUid == request.auth.uid;
    }

    match /threads/{threadId} {
      allow read: if request.auth != null && (resource.data.clientId == request.auth.uid || isStaff());
      allow create: if request.auth != null && (request.resource.data.clientId == request.auth.uid || isStaff());

      // The owner of a thread can never be changed
      allow update: if request.auth != null &&
      (resource.data.clientId == request.auth.uid || isStaff()) &&
      request.resource.data.clientId == resource.data.clientId;

      match /messages/{messageId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/threads/$(threadId)).data.clientId == request.auth.uid || isStaff()
        );
        allow create: if request.auth != null && (
          get(/databases/$(database)/documents/threads/$(threadId)).data.clientId == request.auth.uid || isStaff()
        ) && request.resource.data.senderId == request.auth.uid;

        // Messages can only be marked as read, never edited
        allow update: if request.auth != null && (
          get(/databases/$(database)/documents/threads/$(threadId)).data.clientId == request.auth.uid || isStaff()
        ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      }
    }

    match /audit_log/{logId} {
      allow read: if isStaff();

      // Entries must carry the signed-in user's own ID. Only 'Failed Login'
      // may be written without signing in (actorUid must then be empty).
      allow create: if
      request.resource.data.keys().hasOnly(['actorUid', 'userType', 'action', 'details', 'timestamp']) &&
      request.resource.data.details is string &&
      request.resource.data.details.size() <= 500 &&
      (
        (request.auth != null && request.resource.data.actorUid == request.auth.uid) ||
        (request.auth == null &&
        request.resource.data.action == 'Failed Login' &&
        request.resource.data.actorUid == '')
      );

      allow update, delete: if false;
    }
  }
}